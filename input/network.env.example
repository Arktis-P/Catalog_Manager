# Catalogue Manager app-scoped Japan proxy
# Recommended: SSH dynamic forwarding through a Linux host located in Tokyo, Japan.
# Copy this example to input/network.env and replace only the placeholder values locally.

CATALOGUE_APP_PROXY_ENABLED=0
CATALOGUE_APP_PROXY_MODE=ssh
CATALOGUE_PROXY_EXPECTED_COUNTRY=JP
CATALOGUE_APP_PROXY_HOST=127.0.0.1
CATALOGUE_APP_PROXY_PORT=1080

# Japan/Tokyo SSH endpoint placeholders.
CATALOGUE_PROXY_SSH_HOST=YOUR_JAPAN_HOST
CATALOGUE_PROXY_SSH_PORT=22
CATALOGUE_PROXY_SSH_USER=YOUR_SSH_USER
CATALOGUE_PROXY_SSH_KEY_FILE=YOUR_LOCAL_SSH_KEY_PATH

# Alternative: a Japan SOCKS5 provider.
# CATALOGUE_APP_PROXY_MODE=socks5
# CATALOGUE_PROXY_UPSTREAM_HOST=YOUR_JAPAN_SOCKS5_HOST
# CATALOGUE_PROXY_UPSTREAM_PORT=1080
# CATALOGUE_PROXY_UPSTREAM_USERNAME=YOUR_PROXY_USERNAME
# CATALOGUE_PROXY_UPSTREAM_PASSWORD=YOUR_PROXY_PASSWORD
