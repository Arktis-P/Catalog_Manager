# Catalogue Manager app-scoped proxy
#
# 1) Copy this file to input/network.env.
# 2) Fill upstream SOCKS5 settings.
# 3) Set CATALOGUE_APP_PROXY_ENABLED=1.
#
# When enabled:
# - Catalogue Manager's dedicated Chrome/Edge external URL traffic uses the proxy.
# - Danbooru/Pybooru API traffic uses the same proxy.
# - The local FastAPI GUI (127.0.0.1) stays direct.
# - Windows system proxy/VPN settings and other applications are not changed.

CATALOGUE_APP_PROXY_ENABLED=0
CATALOGUE_APP_PROXY_HOST=127.0.0.1
CATALOGUE_APP_PROXY_PORT=1080

# Generic upstream SOCKS5 endpoint. Username/password may be left empty if the
# upstream does not require authentication.
#
# NordVPN example (verify available hosts in current NordVPN support docs):
#   amsterdam.nl.socks.nordhold.net
#   stockholm.se.socks.nordhold.net
#   new-york.us.socks.nordhold.net
# Port is normally 1080. Use NordVPN *service credentials*, not account login.
CATALOGUE_PROXY_UPSTREAM_HOST=amsterdam.nl.socks.nordhold.net
CATALOGUE_PROXY_UPSTREAM_PORT=1080
CATALOGUE_PROXY_UPSTREAM_USERNAME=your_service_username
CATALOGUE_PROXY_UPSTREAM_PASSWORD=your_service_password
